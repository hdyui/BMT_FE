# Origin của backend BMT (ASP.NET). Chỉ dùng ở phía server: next.config.ts chuyển
# tiếp /api/v1/* sang đây và server component gọi các endpoint công khai từ đây.
# Trình duyệt luôn gọi cùng origin /api/v1/* nên cookie đăng nhập (SameSite=Lax) là
# first-party; KHÔNG dùng biến NEXT_PUBLIC_* để gọi thẳng backend từ trình duyệt.
# Không đặt thì mặc định là bản deploy https://bmt-deploy-latest.onrender.com
BMT_API_ORIGIN=https://bmt-deploy-latest.onrender.com
